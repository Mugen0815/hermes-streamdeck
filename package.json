{
  "name": "hermes-streamdeck",
  "version": "0.3.0",
  "private": true,
  "description": "Stream Deck plugin to start, monitor and stop Hermes Agent runs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart io.github.mugen0815.hermes-streamdeck\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "streamdeck validate io.github.mugen0815.hermes-streamdeck.sdPlugin",
    "pack": "streamdeck pack io.github.mugen0815.hermes-streamdeck.sdPlugin --output dist --force"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.4"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.4",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "rollup": "^4.67.4",
    "tslib": "^2.9.1",
    "typescript": "~5.9",
    "vitest": "^5.1.0"
  }
}
